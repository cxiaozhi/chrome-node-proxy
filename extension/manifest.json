{
  "manifest_version": 3,
  "name": "直连代理",
  "version": "1.4.2",
  "description": "导入订阅，启用 HTTP、SOCKS、Shadowsocks 和 VMess 节点。",
  "permissions": [
    "proxy",
    "storage",
    "nativeMessaging",
    "webRequest",
    "webRequestAuthProvider"
  ],
  "host_permissions": [
    "https://proxy-auth.invalid/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.mjs",
    "type": "module"
  },
  "incognito": "not_allowed",
  "action": {
    "default_title": "直连代理",
    "default_popup": "popup.html",
    "default_icon": "icon48.png"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "key": ""
}
